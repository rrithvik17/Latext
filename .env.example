# Database Configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
POSTGRES_DB=latext
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_change_me@db:5432/latext

# Security Configurations
JWT_SECRET=supersecretjwtkeythatisverylongandsecurechangeinproduction
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Service
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Frontend Service
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Scheduler & Worker Configurations
SCHEDULER_POLL_INTERVAL_SECONDS=5
SCHEDULED_MESSAGE_PROCESSING_TIMEOUT_SECONDS=60

